{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "frontend/dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.js?__sikka_path=/api/:path*"
    },
    {
      "source": "/uploads/:path*",
      "destination": "/api/index.js?__sikka_path=/uploads/:path*"
    },
    {
      "source": "/share/:path*",
      "destination": "/api/index.js?__sikka_path=/share/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
